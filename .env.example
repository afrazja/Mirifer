PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ElevenLabs key (no PUBLIC_ prefix — must stay off the client)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional admin credential login. No built-in credentials; unset means disabled.
# Rotating these invalidates all existing admin cookies.
# ADMIN_EMAIL=your-admin-email@example.com
# ADMIN_PASSWORD=choose-a-long-unique-secret

# ── Google Search Console ────────────────────────────────────────────────
# Ownership token for the HTML-tag verification method. Paste ONLY the
# content value — the long string from content="..." — not the whole tag.
# When set, a <meta name="google-site-verification"> is rendered on every
# page; when unset, nothing is emitted. Safe to expose: it proves ownership
# to Google and grants nothing to anyone who reads it.
# Not needed at all if the domain is verified by DNS TXT record instead,
# which is the better option since it covers www, non-www and subdomains.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Required for Learner Insights: apply supabase-learner-insights.sql first.
# Server-side only — NEVER expose with a PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional voice overrides for /proxy/tts (defaults: George for the learner
# side, Sarah for the conversation partner — premade voices, free-tier OK).
# On a paid ElevenLabs plan you can switch to native German library voices,
# e.g. Otto (A) + Mila (B) below — already added to the account's My Voices.
# ELEVENLABS_VOICE_ID=FTNCalFNG5bRnkkaP5Ug
# ELEVENLABS_VOICE_ID_B=dCnu06FiOZma2KVNUoPZ
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Conversation partner (/proxy/converse) ─────────────────────────────────
# Provider chain: Gemini (free tier) → DeepSeek (cheap) → OpenAI (last resort).
# Set at least one key to enable the conversation card. All server-side only —
# NEVER expose with a PUBLIC_ prefix.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-flash
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini

# ── Persian (fa-IR) TTS ──────────────────────────────────────────────────
# Persian audio works OUT OF THE BOX via Microsoft Edge's read-aloud service
# (free, no key). The optional providers below are tried in this order:
#   1. Azure Speech (official; free F0 tier: 500k chars/month) — set both:
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=germanywestcentral
#
#   NOTE: this same pair also unlocks /proxy/pronounce — per-phoneme
#   pronunciation scoring, the one thing transcription cannot do (a
#   recognizer's language model repairs the accent before we ever see it).
#   Until it is set, /proxy/pronounce answers 503 and the app falls back to
#   the local umlaut/ich-Laut diagnosis in src/lib/services/pronunciation.ts.
#   Free F0 tier includes 5 audio-hours/month of assessment.
#   2. Edge read-aloud — free, zero config (default provider)
#   3. AiVOOV (aivoov.com, paid character credits) — key from Profile → API.
#      Voice IDs are AiVOOV UUIDs: run `npm run aivoov:voices` (limit: 20
#      calls/day) and pin your picks:
# AIVOOV_API_KEY=your-aivoov-api-key
# AIVOOV_VOICE_FA=uuid-of-persian-voice-a
# AIVOOV_VOICE_FA_B=uuid-of-persian-voice-b
# Voice overrides for Azure AND Edge (defaults: Dilara for A, Farid for B):
# AZURE_SPEECH_VOICE_FA=fa-IR-DilaraNeural
# AZURE_SPEECH_VOICE_FA_B=fa-IR-FaridNeural

# ── English & German-fallback voices (Edge read-aloud, free, no key) ─────
# English goes through Edge neural voices (browser/Google ones are robotic).
# German uses Edge only as fallback when the ElevenLabs quota is exhausted.
# EDGE_TTS_VOICE_EN=en-US-AndrewMultilingualNeural
# EDGE_TTS_VOICE_EN_B=en-US-AvaMultilingualNeural
# EDGE_TTS_VOICE_DE=de-DE-FlorianMultilingualNeural
# EDGE_TTS_VOICE_DE_B=de-DE-SeraphinaMultilingualNeural
